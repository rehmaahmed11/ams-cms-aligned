{
  "name": "ams-cms-aligned",
  "version": "1.0.0",
  "private": true,
  "description": "AMS CMS — Cloudflare Worker + D1 (bcms) + KV (bcms)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create bcms",
    "db:migrate:local": "wrangler d1 migrations apply bcms --local",
    "db:migrate:remote": "wrangler d1 migrations apply bcms --remote",
    "db:seed:local": "wrangler d1 execute bcms --local --file=seed.sql",
    "db:seed:remote": "wrangler d1 execute bcms --remote --file=seed.sql",
    "kv:create": "wrangler kv namespace create bcms"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
